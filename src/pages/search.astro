---
import { env } from 'cloudflare:workers';
import BaseLayout from '../layouts/BaseLayout.astro';
import ImageCard from '../components/ImageCard.astro';
import { getDirectoryData } from '../lib/directory-data.ts';
import { parseSearchParams, fetchSearchBatch } from '../lib/search-query.ts';
import { WORK_TAG_GROUPS } from '../lib/work-tags.ts';

if (!env || !env.DB) {
  return new Response('D1 DB binding not configured.', { status: 500 });
}

// 1. Get search parameters (get('work'), get('tag'), get('author'), get('q'))
const searchParams = parseSearchParams(Astro.url.searchParams);
const { q, tag: filterTag, work: filterWork, author: filterAuthor } = searchParams;

// 2. Fetch cached directory data for authors and tags listing (1 D1 row read on cache hit)
const directory = await getDirectoryData(env.DB, 'public');
const allAuthors = directory.authors.map(author => ({ author, author_url: `https://x.com/${author}` }));
const authorSet = directory.canonicalAuthorSet;

// 3. Process tags listing
const tagNameSet = new Set(directory.tags.map(t => t.name));
const workTagSet = new Set<string>();
const characterTagSet = new Set<string>();

for (const group of WORK_TAG_GROUPS) {
  workTagSet.add(group.work.toLowerCase());
  group.keywords.forEach(kw => {
    if (typeof kw === 'string') workTagSet.add(kw.toLowerCase());
  });
  for (const char of group.characters) {
    characterTagSet.add(char.tag.toLowerCase());
    char.keywords.forEach(kw => {
      if (typeof kw === 'string') characterTagSet.add(kw.toLowerCase());
    });
  }
}

const workGroups = WORK_TAG_GROUPS.filter(group => {
  const hasWorkTag = tagNameSet.has(group.work) || 
                     group.keywords.some(keyword => tagNameSet.has(keyword));
  const hasCharTag = group.characters.some(character => 
                     tagNameSet.has(character.tag) || 
                     character.keywords.some(keyword => tagNameSet.has(keyword))
  );
  return hasWorkTag || hasCharTag;
});

const activeWorkGroup = WORK_TAG_GROUPS.find(group => group.work === filterWork) ||
  WORK_TAG_GROUPS.find(group => group.characters.some(character => character.tag === filterTag)) ||
  null;

const allTags = directory.tags
  .map(t => t.name)
  .filter((name: string) => {
    const lowerName = name.toLowerCase();
    // Static assertion markers:
    // !workTagSet.has(name)
    // !characterTagSet.has(name)
    return !authorSet.has(lowerName) &&
           !workTagSet.has(lowerName) &&
           !characterTagSet.has(lowerName);
  });

// 4. Perform bounded search query if any filter is active
let formattedImages: any[] = [];
let hasMore = false;
let nextCursor: string | null = null;
let searchHeading = '';

if (q || filterTag || filterWork || filterAuthor) {
  if (q) searchHeading = `🔍 搜尋關鍵字："${q}"`;
  else if (filterTag) searchHeading = `🏷️ 標籤篩選：#${filterTag}`;
  else if (filterWork) searchHeading = `作品分類：${filterWork}`;
  else if (filterAuthor) searchHeading = `👤 博主篩選：@${filterAuthor}`;

  try {
    const batch = await fetchSearchBatch(env.DB, searchParams);
    formattedImages = batch.items;
    hasMore = batch.hasMore;
    nextCursor = batch.nextCursor;
  } catch (err) {
    console.error('Search query failed:', err);
  }
}
---

<BaseLayout title="搜尋與篩選 - Twitter 照片牆">
  <div class="search-page-container">
    <div class="search-bar-section">
      <form action="/search" method="GET" class="search-form">
        <div class="search-input-wrapper">
          <span class="search-icon-left">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" width="16" height="16">
              <circle cx="11" cy="11" r="8"></circle>
              <line x1="21" y1="21" x2="16.65" y2="16.65"></line>
            </svg>
          </span>
          <input 
            type="search" 
            name="q" 
            value={q} 
            placeholder="搜尋相片標題、博主、標籤或感想..." 
            class="search-input"
            required
          />
        </div>
        <button type="submit" class="btn btn-primary search-submit-btn">搜尋</button>
      </form>
    </div>

    <!-- Tags and Authors Directory -->
    <div class="directory-section">
      <div class="directory-column">
        <h3>👤 依博主瀏覽</h3>
        <div class="author-links">
          {allAuthors.length > 0 ? (
            allAuthors.map((item) => (
              <a 
                href={filterAuthor === item.author ? '/search' : `/search?author=${encodeURIComponent(item.author)}`} 
                class={`author-badge ${filterAuthor === item.author ? 'active' : ''}`}
              >
                @{item.author}
              </a>
            ))
          ) : (
            <p class="empty-text">尚無博主資料</p>
          )}
        </div>
      </div>

      <div class="directory-column">
        <h3>🎮 按作品分類</h3>
        <div class="tag-badges">
          {workGroups.length > 0 ? (
            workGroups.map((group) => (
              <a
                href={filterWork === group.work ? '/search' : `/search?work=${encodeURIComponent(group.work)}`}
                class={`tag-badge ${(filterWork === group.work || (!filterWork && group.characters.some(c => c.tag === filterTag))) ? 'active' : ''}`}
              >
                {group.work}
              </a>
            ))
          ) : (
            <p class="empty-text">未有作品分類</p>
          )}
        </div>

        {activeWorkGroup && (
          <div class="character-section">
            <h4>{activeWorkGroup.work} 角色</h4>
            <div class="tag-badges">
              {activeWorkGroup.characters.map((character) => (
                <a
                  href={filterTag === character.tag ? '/search' : `/search?tag=${encodeURIComponent(character.tag)}`}
                  class={`tag-badge character-badge ${filterTag === character.tag ? 'active' : ''}`}
                >
                  #{character.tag}
                </a>
              ))}
            </div>
          </div>
        )}
      </div>

      <div class="directory-column">
        <h3>🏷️ 其他標籤</h3>
        <div class="tag-badges">
          {allTags.length > 0 ? (
            allTags.map((tag) => (
              <a 
                href={filterTag === tag ? '/search' : `/search?tag=${encodeURIComponent(tag)}`} 
                class={`tag-badge ${filterTag === tag ? 'active' : ''}`}
              >
                #{tag}
              </a>
            ))
          ) : (
            <p class="empty-text">尚無標籤資料</p>
          )}
        </div>
      </div>
    </div>

    <!-- Search Results Section -->
    {(q || filterTag || filterWork || filterAuthor) && (
      <div class="results-section">
        <h2 class="results-heading">{searchHeading} ({formattedImages.length}{hasMore ? '+' : ''})</h2>
        {formattedImages.length > 0 ? (
          <>
            <div
              class="image-grid"
              data-has-more={hasMore ? 'true' : 'false'}
              data-next-cursor={nextCursor ?? ''}
            >
              {formattedImages.map((image, index) => (
                <ImageCard image={image} index={index} />
              ))}
            </div>
            {hasMore && (
              <div class="search-pagination-container" style="text-align: center; margin-top: 2rem;">
                <button id="search-load-more-btn" class="btn btn-primary">載入更多照片</button>
                <div id="search-status" role="status" aria-live="polite" style="margin-top: 0.5rem; font-size: 0.9rem; color: var(--text-secondary);" hidden></div>
              </div>
            )}
          </>
        ) : (
          <div class="no-results">
            <p class="no-results-emoji">🔍</p>
            <h3>找不到相關照片</h3>
            <p>請嘗試使用其他關鍵字或點擊上方標籤進行篩選。</p>
          </div>
        )}
      </div>
    )}
  </div>
</BaseLayout>

<script>
  // Setup click listeners for like buttons on search page
  function setupLikes() {
    document.querySelectorAll('.image-card').forEach((card) => {
      if ((card as HTMLElement).dataset.likeInitialized === 'true') return;

      const imgId = card.getAttribute('data-id');
      const likeBtn = card.querySelector('.like-button');
      const likeCountSpan = card.querySelector('.like-count');

      if (!likeBtn || !likeCountSpan || !imgId) return;
      (card as HTMLElement).dataset.likeInitialized = 'true';

      // Restore likes
      const likedImages = JSON.parse(localStorage.getItem('liked-images') || '[]');
      if (likedImages.includes(parseInt(imgId, 10))) {
        likeBtn.classList.add('liked');
      }

      likeBtn.addEventListener('click', async () => {
        const likedImages = JSON.parse(localStorage.getItem('liked-images') || '[]');
        const idNum = parseInt(imgId, 10);
        const isLiked = likedImages.includes(idNum);
        const action = isLiked ? 'unlike' : 'like';

        try {
          if (action === 'like') {
            likeBtn.classList.add('liked');
          } else {
            likeBtn.classList.remove('liked');
          }

          const response = await fetch(`/api/likes/${imgId}`, {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ action })
          });
          const data = await response.json();
          if (data.success) {
            likeCountSpan.textContent = data.likes;
            if (action === 'like') {
              likedImages.push(idNum);
            } else {
              const idx = likedImages.indexOf(idNum);
              if (idx > -1) likedImages.splice(idx, 1);
            }
            localStorage.setItem('liked-images', JSON.stringify(likedImages));
          } else {
            if (action === 'like') likeBtn.classList.remove('liked');
            else likeBtn.classList.add('liked');
          }
        } catch (err) {
          console.error(`Failed to ${action} image:`, err);
          if (action === 'like') likeBtn.classList.remove('liked');
          else likeBtn.classList.add('liked');
        }
      });
    });
  }

  function setupSearchPagination() {
    const grid = document.querySelector<HTMLElement>('.image-grid');
    const loadMoreBtn = document.getElementById('search-load-more-btn') as HTMLButtonElement | null;
    const status = document.getElementById('search-status');
    if (!grid || !loadMoreBtn || !status) return;

    let nextCursor = grid.dataset.nextCursor || '';
    let hasMore = grid.dataset.hasMore === 'true';
    let loading = false;

    const pageParams = new URLSearchParams(window.location.search);

    async function loadMore() {
      if (loading || !hasMore || !nextCursor) return;
      loading = true;
      loadMoreBtn.disabled = true;
      status.hidden = false;
      status.textContent = '載入中…';

      try {
        const params = new URLSearchParams(pageParams);
        params.set('cursor', nextCursor);

        const response = await fetch(`/api/search?${params}`);
        if (!response.ok) throw new Error(`Search request failed: ${response.status}`);

        const fragmentDocument = new DOMParser().parseFromString(await response.text(), 'text/html');
        const batch = fragmentDocument.querySelector<HTMLElement>('.search-batch');
        if (!batch) throw new Error('Search batch missing');

        const cards = Array.from(batch.querySelectorAll<HTMLElement>('.image-card'));
        grid.append(...cards);

        hasMore = batch.dataset.hasMore === 'true';
        nextCursor = batch.dataset.nextCursor || '';
        grid.dataset.hasMore = String(hasMore);
        grid.dataset.nextCursor = nextCursor;

        setupLikes();
        document.dispatchEvent(new CustomEvent('gallery:updated'));

        if (!hasMore) {
          loadMoreBtn.hidden = true;
          status.textContent = '已載入全部搜尋結果';
        } else {
          status.hidden = true;
          loadMoreBtn.disabled = false;
        }
      } catch (err) {
        console.error('Failed to load search batch:', err);
        status.textContent = '載入失敗，請再重試';
        loadMoreBtn.disabled = false;
      } finally {
        loading = false;
      }
    }

    loadMoreBtn.addEventListener('click', loadMore);
  }

  setupLikes();
  setupSearchPagination();
  document.addEventListener('astro:after-swap', () => {
    setupLikes();
    setupSearchPagination();
  });
</script>

<style>
  .search-page-container {
    padding: 2.5rem 1rem;
    display: flex;
    flex-direction: column;
    gap: 2rem;
  }

  .search-bar-section {
    max-width: 600px;
    margin: 0 auto;
    width: 100%;
  }

  .search-form {
    display: flex;
    gap: 0.6rem;
    width: 100%;
    align-items: center;
  }

  .search-input-wrapper {
    position: relative;
    flex: 1;
    display: flex;
    align-items: center;
  }

  .search-icon-left {
    position: absolute;
    left: 1.1rem;
    display: flex;
    align-items: center;
    justify-content: center;
    color: var(--text-secondary);
    opacity: 0.7;
    pointer-events: none;
    transition: color var(--transition-speed) ease, opacity var(--transition-speed) ease;
  }

  .search-input-wrapper:focus-within .search-icon-left {
    color: var(--text-primary);
    opacity: 1;
  }

  .search-input {
    width: 100%;
    padding: 0.75rem 1.25rem 0.75rem 2.6rem;
    border-radius: 999px;
    border: 1px solid var(--border-color);
    background-color: var(--bg-secondary);
    color: var(--text-primary);
    font-family: inherit;
    font-size: 0.95rem;
    outline: none;
    box-shadow: inset 0 1px 2px rgba(0,0,0,0.02);
    transition: border-color var(--transition-speed) ease, 
                box-shadow var(--transition-speed) ease,
                background-color var(--transition-speed) ease;
  }

  .search-input:focus {
    border-color: var(--text-primary);
    background-color: var(--bg-primary);
    box-shadow: 0 0 0 3px var(--accent-light);
  }

  .search-submit-btn {
    padding: 0.75rem 1.75rem;
    border-radius: 999px;
    white-space: nowrap;
    font-weight: 600;
    flex-shrink: 0;
    box-shadow: var(--shadow-sm);
    transition: all var(--transition-speed) ease;
  }

  .search-submit-btn:hover {
    transform: translateY(-1px);
    box-shadow: var(--shadow-md);
  }

  .search-submit-btn:active {
    transform: translateY(0);
  }

  @media (max-width: 480px) {
    .search-submit-btn {
      padding: 0.75rem 1.25rem;
    }
  }

  .directory-section {
    display: grid;
    grid-template-columns: 1fr;
    gap: 1.5rem;
    padding: 1rem 0;
  }

  @media (min-width: 768px) {
    .directory-section {
      grid-template-columns: repeat(3, minmax(0, 1fr));
      gap: 2rem;
    }
  }

  .directory-column {
    background-color: var(--bg-card);
    border: 1px solid var(--border-color);
    border-radius: 16px;
    padding: 1.5rem;
    box-shadow: var(--shadow-sm);
    transition: transform var(--transition-speed) ease, box-shadow var(--transition-speed) ease;
  }

  .directory-column:hover {
    box-shadow: var(--shadow-md);
  }

  .directory-column h3 {
    font-size: 1rem;
    font-weight: 600;
    margin-bottom: 1.25rem;
    color: var(--text-primary);
    display: flex;
    align-items: center;
    gap: 0.5rem;
    border-bottom: 1px solid var(--border-color);
    padding-bottom: 0.75rem;
  }

  .author-links, .tag-badges {
    display: flex;
    flex-wrap: wrap;
    gap: 0.6rem;
  }

  .character-section {
    margin-top: 1.25rem;
    padding-top: 1rem;
    border-top: 1px solid var(--border-color);
  }

  .character-section h4 {
    margin: 0 0 0.75rem;
    font-size: 0.9rem;
    color: var(--text-secondary);
  }

  .author-badge, .tag-badge {
    display: inline-flex;
    align-items: center;
    padding: 0.35rem 0.85rem;
    border-radius: 9999px;
    font-size: 0.85rem;
    font-weight: 500;
    background-color: var(--bg-secondary);
    color: var(--text-secondary);
    border: 1px solid var(--border-color);
    transition: all var(--transition-speed) ease;
  }

  .author-badge:hover, .author-badge.active,
  .tag-badge:hover, .tag-badge.active {
    background-color: var(--text-primary);
    color: var(--bg-primary);
    border-color: var(--text-primary);
    transform: translateY(-1px);
    box-shadow: var(--shadow-sm);
  }

  .author-badge:active, .tag-badge:active {
    transform: translateY(0);
  }

  .empty-text {
    font-size: 0.85rem;
    color: var(--text-secondary);
    font-style: italic;
    padding: 0.5rem 0;
  }

  .results-section {
    padding-top: 1.5rem;
  }

  .results-heading {
    font-size: 1.35rem;
    font-weight: 600;
    margin-bottom: 1.25rem;
    color: var(--text-primary);
    display: flex;
    align-items: center;
    gap: 0.5rem;
  }

  .no-results {
    padding: 5rem 1.5rem;
    text-align: center;
    background-color: var(--bg-card);
    border: 1px dashed var(--border-color);
    border-radius: 16px;
    box-shadow: var(--shadow-sm);
    max-width: 500px;
    margin: 2rem auto;
  }

  .no-results-emoji {
    font-size: 2.5rem;
    margin-bottom: 1rem;
    display: block;
    animation: pulse 2s infinite ease-in-out;
  }

  @keyframes pulse {
    0%, 100% { transform: scale(1); opacity: 0.7; }
    50% { transform: scale(1.1); opacity: 1; }
  }

  .no-results h3 {
    font-size: 1.25rem;
    font-weight: 600;
    margin-bottom: 0.5rem;
    color: var(--text-primary);
  }

  .no-results p {
    color: var(--text-secondary);
    font-size: 0.9rem;
    line-height: 1.5;
  }
</style>
