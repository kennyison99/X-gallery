---
import { env } from 'cloudflare:workers';
import BaseLayout from '../../layouts/BaseLayout.astro';
import '../../styles/admin.css';
import AdminDashboardTabs from '../../components/admin/AdminDashboardTabs.astro';
import AdminOverview from '../../components/admin/AdminOverview.astro';
import AdminUploadPanel from '../../components/admin/AdminUploadPanel.astro';
import AdminPostManager from '../../components/admin/AdminPostManager.astro';
import AdminCrawlerPanel from '../../components/admin/AdminCrawlerPanel.astro';
import AdminAutoTagPanel from '../../components/admin/AdminAutoTagPanel.astro';
import { getDirectoryData, getAdminOverviewStats } from '../../lib/directory-data';

if (!env || !env.DB) {
  return new Response('D1 DB binding not configured. Please bind your database in wrangler.jsonc.', { status: 500 });
}

// 1. Fetch storage stats (1 D1 row read)
let storageStats = { total_bytes: 0, media_counts_ready: 0, directory_version: 1 };
try {
  const statsRow = await env.DB.prepare('SELECT total_bytes, media_counts_ready, directory_version FROM storage_stats WHERE id = 1').first<any>();
  if (statsRow) storageStats = statsRow;
} catch (err) {
  console.error('Error fetching storage stats:', err);
}

const mediaCountsReady = storageStats.media_counts_ready === 1;
const directoryVersion = storageStats.directory_version ?? 1;

// 2. Fetch consolidated overview & author stats via versioned cache (0 additional image scans on cache hit)
let overviewStats = {
  totalPosts: 0,
  publishedCount: 0,
  pendingCount: 0,
  totalPhotos: 0,
  totalVideos: 0,
  authorStats: [] as any[],
};

try {
  overviewStats = await getAdminOverviewStats(env.DB, directoryVersion, { mediaCountsReady });
} catch (err) {
  console.error('Error fetching admin overview stats:', err);
}

const { totalPosts, publishedCount, pendingCount, totalPhotos, totalVideos, authorStats } = overviewStats;

// 3. Derive admin authors from overview stats to avoid duplicate GROUP BY author scan
const adminAuthors = authorStats.map((r) => ({
  author: r.author,
  author_display_name: r.author_display_name,
}));

// 4. Fetch cached directory data for admin scope (reuses version and adminAuthors)
const directory = await getDirectoryData(env.DB, 'admin', { version: directoryVersion, adminAuthors });
const authorSet = directory.canonicalAuthorSet;

// 5. Prepare tags and authors for filter dropdown
const allTags = directory.tags.filter((tag) => !authorSet.has(tag.name.toLowerCase()));
const authorsForFilter = (directory.adminAuthors || []).map((r) => ({
  handle: r.author,
  label: r.author_display_name ? `${r.author_display_name}@${r.author}` : `@${r.author}`,
}));

// 6. Fetch crawl accounts
let crawlAccounts = [];
try {
  const { results } = await env.DB.prepare('SELECT * FROM crawl_accounts ORDER BY created_at DESC').all();
  crawlAccounts = (results || []).map((a: any) => {
    // Build "最近一次" display text from last crawl metadata
    let lastCrawlText = '';
    const lastCrawlError = typeof a.last_crawl_error === 'string' ? a.last_crawl_error : '';
    if (a.last_crawled_at) {
      const d = new Date(a.last_crawled_at);
      const dateStr = `${d.getDate()}/${d.getMonth() + 1}/${d.getFullYear()}`;
      const typeLabel = a.last_crawl_type === 'manual' ? '手動' : '自動';
      const modeLabel = a.last_crawl_mode === 'all' ? '全歷史' : '最新';
      const count = a.last_crawl_count ?? 0;
      lastCrawlText = `於 ${dateStr} ${typeLabel}爬取${modeLabel} (+${count})`;
    }
    return { ...a, lastCrawlText, lastCrawlError };
  });
} catch (err) {
  console.error('Error fetching crawl accounts:', err);
}

---

<BaseLayout title="CMS 後台管理 - Twitter 照片牆">
  <div class="admin-container">
    <div class="admin-header">
      <h1>CMS 管理後台</h1>
      <p>上傳多張相片作為單一卡片貼文到 R2，並管理所有照片與標籤資料。</p>
    </div>

    <AdminDashboardTabs />

    <AdminOverview
      totalPosts={totalPosts}
      totalPhotos={totalPhotos}
      totalVideos={totalVideos}
      pendingPosts={pendingCount}
      totalAccounts={crawlAccounts.length}
      enabledAccounts={crawlAccounts.filter((account) => account.enabled === 1).length}
      authorStats={authorStats}
    />

    <div class="admin-grid">
      <AdminUploadPanel allTags={allTags} />

      <AdminPostManager
        publishedCount={publishedCount}
        pendingCount={pendingCount}
        authors={authorsForFilter}
        tags={allTags.map((t: any) => t.name)}
      />

      <AdminAutoTagPanel />

      <AdminCrawlerPanel accounts={crawlAccounts} />
    </div>
  </div>
</BaseLayout>

<script>
  import { resolveAdminTab } from '../../lib/admin-dashboard';
  import {
    rectOverlap,
    getSelectionRect,
    computePageSelectionState,
    applySelectionMode,
  } from '../../lib/admin-selection';

  // Lazily load post manager thumbnails only when the posts tab is active,
  // so hidden panels don't trigger R2 fetches on page load.
  function hydratePostMedia() {
    const activeTab = resolveAdminTab(window.location.hash);
    if (activeTab !== 'posts') return;
    document.querySelectorAll<HTMLImageElement | HTMLVideoElement>('#panel-posts [data-src]').forEach((el) => {
      el.src = el.dataset.src!;
      el.removeAttribute('data-src');
    });
  }

  function activateAdminTab() {
    const activeTab = resolveAdminTab(window.location.hash);
    if (window.location.hash !== `#${activeTab}`) {
      history.replaceState(null, '', `#${activeTab}`);
    }

    document.querySelectorAll<HTMLElement>('[data-admin-tab]').forEach((tab) => {
      const selected = tab.dataset.adminTab === activeTab;
      tab.classList.toggle('active', selected);
      tab.setAttribute('aria-selected', String(selected));
      tab.tabIndex = selected ? 0 : -1;
    });

    document.querySelectorAll<HTMLElement>('[data-admin-panel]').forEach((panel) => {
      panel.hidden = panel.dataset.adminPanel !== activeTab;
    });

    if (activeTab === 'posts') hydratePostMedia();
  }

  window.addEventListener('hashchange', activateAdminTab);
  activateAdminTab();

  document.querySelector('[role="tablist"]')?.addEventListener('keydown', (event) => {
    if (!(event instanceof KeyboardEvent) || !['ArrowLeft', 'ArrowRight'].includes(event.key)) return;
    const tabs = [...document.querySelectorAll<HTMLAnchorElement>('[data-admin-tab]')];
    const currentIndex = tabs.indexOf(document.activeElement as HTMLAnchorElement);
    if (currentIndex < 0) return;
    event.preventDefault();
    const direction = event.key === 'ArrowRight' ? 1 : -1;
    tabs[(currentIndex + direction + tabs.length) % tabs.length].focus();
  });

  document.querySelector('[data-post-status="pending"]')?.addEventListener('click', () => {
    document.getElementById('tab-pending')?.click();
  });

  import { runSequentialBatches } from '../../lib/batches.ts';

  // ---- R2 storage capacity widget ----
  function formatBytes(bytes: number): string {
    if (bytes < 1000) return `${bytes} B`;
    if (bytes < 1000 * 1000) return `${(bytes / 1000).toFixed(1)} KB`;
    if (bytes < 1000 * 1000 * 1000) return `${(bytes / (1000 * 1000)).toFixed(1)} MB`;
    return `${(bytes / (1000 * 1000 * 1000)).toFixed(2)} GB`;
  }

  const storageBarFill = document.getElementById('storage-bar-fill');
  const storageUsed = document.getElementById('storage-used');
  const storageWarning = document.getElementById('storage-warning');
  const storageReconcileBtn = document.getElementById('storage-reconcile-btn') as HTMLButtonElement | null;

  async function refreshStorage(reconcile = false) {
    try {
      const res = await fetch('/api/storage-stats', reconcile ? { method: 'POST' } : {});
      const data = await res.json();
      if (!res.ok) throw new Error(data.error || '讀取失敗');
      const total = Number(data.total_bytes || 0);
      const limit = Number(data.limit_bytes || 10 * 1000 * 1000 * 1000);
      const pct = Math.min(100, (total / limit) * 100);

      if (storageBarFill) {
        storageBarFill.style.width = `${pct}%`;
        storageBarFill.classList.remove('warn', 'critical');
        if (pct >= 90) storageBarFill.classList.add('critical');
        else if (pct >= 80) storageBarFill.classList.add('warn');
      }
      if (storageUsed) {
        storageUsed.textContent = `${formatBytes(total)} / ${formatBytes(limit)} (${pct.toFixed(1)}%)`;
      }
      if (storageWarning) {
        if (pct >= 95) {
          storageWarning.textContent = '⚠️ 已達 95% 上限，新上傳將被拒絕。請先刪除舊資料。';
          storageWarning.hidden = false;
        } else if (pct >= 90) {
          storageWarning.textContent = '⚠️ 容量已超過 90%，請留意用量。';
          storageWarning.hidden = false;
        } else if (pct >= 80) {
          storageWarning.textContent = '提醒：容量已超過 80%。';
          storageWarning.hidden = false;
        } else {
          storageWarning.hidden = true;
        }
      }
    } catch (err: any) {
      if (storageUsed) storageUsed.textContent = `讀取失敗：${err.message}`;
    }
  }

  refreshStorage();
  storageReconcileBtn?.addEventListener('click', async () => {
    if (!storageReconcileBtn) return;
    storageReconcileBtn.disabled = true;
    storageReconcileBtn.textContent = '計算中…';
    await refreshStorage(true);
    storageReconcileBtn.disabled = false;
    storageReconcileBtn.textContent = '重新計算';
  });

  // Persistent Selection Toolbar UI bindings
  const selectAllCheckbox = document.getElementById('select-all-checkbox') as HTMLInputElement | null;
  const selectPageBtn = document.getElementById('select-page-btn') as HTMLButtonElement | null;
  const clearSelectionBtn = document.getElementById('clear-selection-btn') as HTMLButtonElement | null;
  const bulkActionsBar = document.getElementById('bulk-actions-bar');
  const selectedCountDisplay = document.getElementById('selected-count-display');
  const bulkDeleteBtn = document.getElementById('bulk-delete-btn') as HTMLButtonElement | null;
  const bulkDeleteProgress = document.getElementById('bulk-delete-progress');
  const bulkDeleteProgressBar = document.getElementById('bulk-delete-progress-bar') as HTMLProgressElement | null;
  const bulkDeleteProgressText = document.getElementById('bulk-delete-progress-text');
  const bulkApproveBtn = document.getElementById('bulk-approve-btn') as HTMLButtonElement | null;
  const bulkApproveProgress = document.getElementById('bulk-approve-progress');
  const bulkApproveProgressBar = document.getElementById('bulk-approve-progress-bar') as HTMLProgressElement | null;
  const bulkApproveProgressText = document.getElementById('bulk-approve-progress-text');

  const tabPublished = document.getElementById('tab-published');
  const tabPending = document.getElementById('tab-pending');
  let activeTab = 'published';

  const autoTagBtn = document.getElementById('auto-tag-btn') as HTMLButtonElement | null;
  const autoTagProgress = document.getElementById('auto-tag-progress');
  const autoTagProgressBar = document.getElementById('auto-tag-progress-bar') as HTMLProgressElement | null;
  const autoTagProgressText = document.getElementById('auto-tag-progress-text');

  function updateOperationProgress(
    container: HTMLElement | null,
    progress: HTMLProgressElement | null,
    text: HTMLElement | null,
    current: number,
    total: number,
    message: string
  ) {
    if (container) container.hidden = false;
    if (progress) {
      progress.max = Math.max(total, 1);
      progress.value = current;
    }
    if (text) text.textContent = message;
  }

  function getActiveSelectionRoot(): HTMLElement | null {
    return activeView === 'grid' ? gridBody : tableBody;
  }

  function getCurrentPageItems(): HTMLElement[] {
    const root = getActiveSelectionRoot();
    if (!root) return [];
    const selector = activeView === 'grid' ? '.grid-image-card' : '.image-row';
    return Array.from(root.querySelectorAll<HTMLElement>(selector));
  }

  function getCurrentPageItemIds(): number[] {
    return getCurrentPageItems()
      .map((el) => parseInt(el.getAttribute('data-id') || '', 10))
      .filter((id) => !isNaN(id));
  }

  function renderSelectionState() {
    const visibleItems = getCurrentPageItems();
    const visibleItemIds = visibleItems
      .map((el) => parseInt(el.getAttribute('data-id') || '', 10))
      .filter((id) => !isNaN(id));

    // Synchronize item classes, checkboxes, aria-selected
    visibleItems.forEach((itemEl) => {
      const id = parseInt(itemEl.getAttribute('data-id') || '', 10);
      const isSelected = selectedIds.has(id);
      itemEl.classList.toggle('is-selected', isSelected);
      itemEl.setAttribute('aria-selected', isSelected ? 'true' : 'false');
    });

    const activeRoot = getActiveSelectionRoot();
    if (activeRoot) {
      activeRoot.querySelectorAll<HTMLInputElement>('.image-select-checkbox').forEach((cb) => {
        const id = parseInt(cb.getAttribute('data-id') || '', 10);
        if (!isNaN(id)) {
          cb.checked = selectedIds.has(id);
        }
      });
    }

    const pageState = computePageSelectionState(visibleItemIds, selectedIds);

    // Header checkbox triple-state
    if (selectAllCheckbox) {
      selectAllCheckbox.checked = pageState.allSelected;
      selectAllCheckbox.indeterminate = pageState.partiallySelected;
      selectAllCheckbox.disabled = visibleItemIds.length === 0;
    }

    // Page toggle button label
    if (selectPageBtn) {
      selectPageBtn.textContent = pageState.allSelected && visibleItemIds.length > 0 ? '取消選取當前頁' : '全選當前頁';
      selectPageBtn.disabled = visibleItemIds.length === 0;
    }

    // Clear selection button
    if (clearSelectionBtn) {
      clearSelectionBtn.disabled = selectedIds.size === 0;
    }

    // Bulk delete button
    if (bulkDeleteBtn) {
      bulkDeleteBtn.disabled = selectedIds.size === 0;
    }

    // Bulk approve button
    if (bulkApproveBtn) {
      bulkApproveBtn.disabled = selectedIds.size === 0;
    }

    // Selected count display
    if (selectedCountDisplay) {
      selectedCountDisplay.textContent = `已選擇 ${selectedIds.size} 筆照片`;
    }
  }

  function toggleCurrentPageSelection() {
    const visibleItemIds = getCurrentPageItemIds();
    const pageState = computePageSelectionState(visibleItemIds, selectedIds);

    if (pageState.allSelected) {
      visibleItemIds.forEach((id) => selectedIds.delete(id));
    } else {
      visibleItemIds.forEach((id) => selectedIds.add(id));
    }

    renderSelectionState();
  }

  // UI interactions for file input
  const fileInput = document.getElementById('image-file') as HTMLInputElement | null;
  const fileNameDisplay = document.querySelector('.file-name-display');
  const uploadPrompt = document.querySelector('.upload-prompt');
  const fileRequiredStar = document.getElementById('file-required-star');
  const formTitleText = document.getElementById('form-title-text');
  const cancelBtn = document.getElementById('cancel-edit-btn') as HTMLButtonElement | null;
  const newTagsInput = document.getElementById('new-tags') as HTMLInputElement | null;

  const titleInput = document.getElementById('image-title') as HTMLInputElement | null;
  const descInput = document.getElementById('image-description') as HTMLTextAreaElement | null;
  const authorInput = document.getElementById('image-author') as HTMLInputElement | null;
  const authorDisplayNameInput = document.getElementById('image-author-display-name') as HTMLInputElement | null;
  const authorUrlInput = document.getElementById('image-author-url') as HTMLInputElement | null;
  const postUrlInput = document.getElementById('image-post-url') as HTMLInputElement | null;

  // Previews elements
  const previewContainer = document.getElementById('image-preview-container');
  const existingPreviewSection = document.getElementById('existing-images-preview');
  const existingGrid = document.getElementById('existing-images-grid');
  const newPreviewSection = document.getElementById('new-images-preview');
  const newGrid = document.getElementById('new-images-grid');

  let isEditMode = false;
  let editingId: string | null = null;

  // Keep track of files and existing keys
  let remainingExistingKeys: string[] = [];
  let selectedNewFiles: File[] = [];

  // Render new selected files preview
  function renderNewFilesPreview() {
    if (!newGrid || !newPreviewSection || !previewContainer) return;
    newGrid.innerHTML = '';
    
    if (selectedNewFiles.length > 0) {
      newPreviewSection.style.display = 'block';
      previewContainer.style.display = 'block';
      
      selectedNewFiles.forEach((file, index) => {
        const itemWrapper = document.createElement('div');
        itemWrapper.style.position = 'relative';
        itemWrapper.style.width = '60px';
        itemWrapper.style.height = '60px';
        
        const img = document.createElement('img');
        img.style.width = '60px';
        img.style.height = '60px';
        img.style.objectFit = 'cover';
        img.style.borderRadius = '4px';
        img.style.border = '1px solid var(--border-color)';
        
        const removeBtn = document.createElement('button');
        removeBtn.type = 'button';
        removeBtn.innerHTML = '×';
        removeBtn.style.position = 'absolute';
        removeBtn.style.top = '-4px';
        removeBtn.style.right = '-4px';
        removeBtn.style.background = 'var(--heart-color)';
        removeBtn.style.color = 'white';
        removeBtn.style.border = 'none';
        removeBtn.style.borderRadius = '50%';
        removeBtn.style.width = '18px';
        removeBtn.style.height = '18px';
        removeBtn.style.fontSize = '10px';
        removeBtn.style.fontWeight = 'bold';
        removeBtn.style.cursor = 'pointer';
        removeBtn.style.display = 'flex';
        removeBtn.style.alignItems = 'center';
        removeBtn.style.justifyContent = 'center';
        removeBtn.style.padding = '0';
        
        removeBtn.addEventListener('click', () => {
          selectedNewFiles.splice(index, 1);
          renderNewFilesPreview();
          updateFileInputDisplay();
        });
        
        const reader = new FileReader();
        reader.onload = (e) => {
          img.src = e.target?.result as string;
        };
        reader.readAsDataURL(file);
        
        itemWrapper.appendChild(img);
        itemWrapper.appendChild(removeBtn);
        newGrid.appendChild(itemWrapper);
      });
    } else {
      newPreviewSection.style.display = 'none';
      if (remainingExistingKeys.length === 0) {
        previewContainer.style.display = 'none';
      }
    }
  }

  // Render existing images preview
  function renderExistingImagesPreview() {
    if (!existingGrid || !existingPreviewSection || !previewContainer) return;
    existingGrid.innerHTML = '';
    
    if (remainingExistingKeys.length > 0) {
      existingPreviewSection.style.display = 'block';
      previewContainer.style.display = 'block';
      
      remainingExistingKeys.forEach((key, index) => {
        const itemWrapper = document.createElement('div');
        itemWrapper.style.position = 'relative';
        itemWrapper.style.width = '60px';
        itemWrapper.style.height = '60px';
        
        const img = document.createElement('img');
        const origin = window.location.origin;
        const isLocal = origin.includes('localhost') || origin.includes('127.0.0.1') || origin.includes('[::1]');
        const mediaUrl = `/api/r2/${encodeURIComponent(key)}`;
        img.src = isLocal ? mediaUrl : `https://wsrv.nl/?url=${encodeURIComponent(origin + mediaUrl)}&w=200&output=webp`;
        img.style.width = '60px';
        img.style.height = '60px';
        img.style.objectFit = 'cover';
        img.style.borderRadius = '4px';
        img.style.border = '1px solid var(--border-color)';
        
        const removeBtn = document.createElement('button');
        removeBtn.type = 'button';
        removeBtn.innerHTML = '×';
        removeBtn.style.position = 'absolute';
        removeBtn.style.top = '-4px';
        removeBtn.style.right = '-4px';
        removeBtn.style.background = 'var(--heart-color)';
        removeBtn.style.color = 'white';
        removeBtn.style.border = 'none';
        removeBtn.style.borderRadius = '50%';
        removeBtn.style.width = '18px';
        removeBtn.style.height = '18px';
        removeBtn.style.fontSize = '10px';
        removeBtn.style.fontWeight = 'bold';
        removeBtn.style.cursor = 'pointer';
        removeBtn.style.display = 'flex';
        removeBtn.style.alignItems = 'center';
        removeBtn.style.justifyContent = 'center';
        removeBtn.style.padding = '0';
        
        removeBtn.addEventListener('click', () => {
          remainingExistingKeys.splice(index, 1);
          renderExistingImagesPreview();
        });
        
        itemWrapper.appendChild(img);
        itemWrapper.appendChild(removeBtn);
        existingGrid.appendChild(itemWrapper);
      });
    } else {
      existingPreviewSection.style.display = 'none';
      if (selectedNewFiles.length === 0) {
        previewContainer.style.display = 'none';
      }
    }
  }

  function updateFileInputDisplay() {
    if (!fileNameDisplay) return;
    const count = selectedNewFiles.length;
    if (count > 0) {
      fileNameDisplay.textContent = `已選取 ${count} 個檔案`;
    } else {
      fileNameDisplay.textContent = '尚未選擇任何檔案';
    }
  }

  if (fileInput) {
    fileInput.addEventListener('change', () => {
      if (fileInput.files) {
        // Accumulate newly selected files
        Array.from(fileInput.files).forEach(file => {
          selectedNewFiles.push(file);
        });
        // Clear file input value so user can select the same file again
        fileInput.value = '';
        updateFileInputDisplay();
        renderNewFilesPreview();
      }
    });
  }

  function resetForm() {
    isEditMode = false;
    editingId = null;
    remainingExistingKeys = [];
    selectedNewFiles = [];
    
    if (uploadForm) uploadForm.reset();
    if (formTitleText) formTitleText.textContent = '發佈相片貼文';
    if (btnText) btnText.textContent = '確認上傳';
    if (cancelBtn) cancelBtn.style.display = 'none';
    if (fileInput) fileInput.required = true;
    if (fileRequiredStar) fileRequiredStar.style.display = 'inline';
    if (uploadPrompt) uploadPrompt.textContent = '點擊選擇照片 (可選多張)';
    if (fileNameDisplay) fileNameDisplay.textContent = '尚未選擇任何檔案';
    
    // Reset previews
    if (existingGrid) existingGrid.innerHTML = '';
    if (existingPreviewSection) existingPreviewSection.style.display = 'none';
    if (newGrid) newGrid.innerHTML = '';
    if (newPreviewSection) newPreviewSection.style.display = 'none';
    if (previewContainer) previewContainer.style.display = 'none';

    if (uploadMessage) {
      uploadMessage.textContent = '';
      uploadMessage.style.display = 'none';
    }
  }

  function enterEditMode(id: string, data: any) {
    isEditMode = true;
    editingId = id;
    selectedNewFiles = [];
    remainingExistingKeys = data.keys.split(',').map((k: string) => k.trim()).filter(Boolean);

    if (formTitleText) formTitleText.textContent = '修改相片貼文';
    if (btnText) btnText.textContent = '確認修改';
    if (cancelBtn) cancelBtn.style.display = 'inline-block';
    if (fileInput) {
      fileInput.required = false;
      fileInput.value = '';
    }
    if (fileRequiredStar) fileRequiredStar.style.display = 'none';
    if (uploadPrompt) uploadPrompt.textContent = '上傳新照片以附加至貼文 (可選多張)';
    if (fileNameDisplay) fileNameDisplay.textContent = '尚未選擇任何檔案';
    
    if (titleInput) titleInput.value = data.title;
    if (descInput) descInput.value = data.description;
    if (authorInput) authorInput.value = data.author;
    if (authorDisplayNameInput) authorDisplayNameInput.value = data.authorDisplayName;
    if (authorUrlInput) authorUrlInput.value = data.authorUrl;
    if (postUrlInput) postUrlInput.value = data.postUrl;

    // Check tags checkboxes
    document.querySelectorAll('input[name="existing_tags"]').forEach((cb) => {
      (cb as HTMLInputElement).checked = false;
    });

    const tagsArray = data.tags.split(',').map((t: string) => t.trim()).filter(Boolean);
    tagsArray.forEach((tag: string) => {
      const checkbox = document.querySelector(`input[name="existing_tags"][value="${tag}"]`) as HTMLInputElement | null;
      if (checkbox) checkbox.checked = true;
    });

    if (newTagsInput) newTagsInput.value = '';

    // Render previews
    renderExistingImagesPreview();
    renderNewFilesPreview();

    if (uploadMessage) {
      uploadMessage.textContent = '';
      uploadMessage.style.display = 'none';
    }
  }

  if (cancelBtn) {
    cancelBtn.addEventListener('click', resetForm);
  }

  // Edit/Delete/Approve buttons are bound dynamically in rebindRowHandlers()
  // after each AJAX page load (see loadPosts below).

  // Handle Form Upload / Modify
  const uploadForm = document.getElementById('upload-form') as HTMLFormElement | null;
  const submitBtn = document.querySelector('.btn-submit') as HTMLButtonElement | null;
  const btnText = document.querySelector('.btn-text');
  const loaderSpinner = document.querySelector('.loader-spinner') as HTMLElement | null;
  const uploadMessage = document.getElementById('upload-message');

  if (uploadForm && submitBtn && btnText && loaderSpinner && uploadMessage) {
    uploadForm.addEventListener('submit', async (e) => {
      e.preventDefault();

      // Check if we have at least one image in total
      const totalImages = (isEditMode ? remainingExistingKeys.length : 0) + selectedNewFiles.length;
      if (totalImages === 0) {
        uploadMessage.textContent = '錯誤：貼文必須至少包含一張照片。';
        uploadMessage.className = 'form-message error';
        uploadMessage.style.display = 'block';
        return;
      }
      
      // Update loading UI
      submitBtn.disabled = true;
      btnText.textContent = isEditMode ? '正在修改中...' : '正在上傳中...';
      if (loaderSpinner) loaderSpinner.style.display = 'inline-block';
      uploadMessage.textContent = '';
      uploadMessage.className = 'form-message';
      uploadMessage.style.display = 'none';

      // 1. Prepare FormData
      const formData = new FormData();
      
      // Add manual selected files
      selectedNewFiles.forEach(file => {
        formData.append('file', file);
      });

      // Add existing keys to keep if in edit mode
      if (isEditMode) {
        formData.append('existing_keys', remainingExistingKeys.join(','));
      }

      formData.append('title', titleInput?.value || '');
      formData.append('description', descInput?.value || '');
      formData.append('author', authorInput?.value || '');
      formData.append('author_url', authorUrlInput?.value || '');
      formData.append('post_url', postUrlInput?.value || '');

      // Combine existing tags and new tags
      const checkedTags: string[] = [];
      document.querySelectorAll('input[name="existing_tags"]:checked').forEach((checkbox) => {
        checkedTags.push((checkbox as HTMLInputElement).value);
      });

      const newTagsRaw = newTagsInput?.value || '';

      const tagsCombined = [
        ...checkedTags,
        ...newTagsRaw.split(/[\s,]+/).map(t => t.trim().replace(/^#/, '')).filter(t => t.length > 0)
      ].join(',');

      formData.append('tags', tagsCombined);

      try {
        const url = isEditMode ? `/api/images/${editingId}` : '/api/images';
        const method = isEditMode ? 'PUT' : 'POST';

        const response = await fetch(url, {
          method: method,
          body: formData
        });

        const data = await response.json();
        
        if (response.ok && data.success) {
          uploadMessage.textContent = isEditMode ? '貼文修改成功！正在重新整理頁面...' : '貼文上傳成功！正在重新整理頁面...';
          uploadMessage.className = 'form-message success';
          uploadMessage.style.display = 'block';
          resetForm();
          
          setTimeout(() => {
            window.location.reload();
          }, 1500);
        } else {
          uploadMessage.textContent = `${isEditMode ? '修改' : '上傳'}失敗：${data.error || '未知錯誤'}`;
          uploadMessage.className = 'form-message error';
          uploadMessage.style.display = 'block';
          submitBtn.disabled = false;
          btnText.textContent = isEditMode ? '確認修改' : '確認上傳';
          if (loaderSpinner) loaderSpinner.style.display = 'none';
        }
      } catch (err) {
        console.error(err);
        uploadMessage.textContent = '網路或伺服器錯誤，請稍後再試。';
        uploadMessage.className = 'form-message error';
        uploadMessage.style.display = 'block';
        submitBtn.disabled = false;
        btnText.textContent = isEditMode ? '確認修改' : '確認上傳';
        if (loaderSpinner) loaderSpinner.style.display = 'none';
      }
    });
  }

  // =========== Crawl Accounts Management ===========
  const crawlUsernameInput = document.getElementById('crawl-username') as HTMLInputElement | null;
  const addCrawlBtn = document.getElementById('add-crawl-btn') as HTMLButtonElement | null;
  const crawlMessage = document.getElementById('crawl-message') as HTMLElement | null;
  const crawlAccountsList = document.getElementById('crawl-accounts-list');
  const crawlEmptyText = document.getElementById('crawl-empty-text');

  function showCrawlMessage(text: string, type: 'success' | 'error') {
    if (!crawlMessage) return;
    crawlMessage.textContent = text;
    crawlMessage.className = `form-message ${type}`;
    crawlMessage.style.display = 'block';
    setTimeout(() => {
      crawlMessage.style.display = 'none';
    }, 3000);
  }

  function normalizeCrawlUsernameInput(input: string) {
    let username = input.trim().replace(/^@+/, '');
    if (username.includes('/') || username.includes('http')) {
      try {
        const cleanUrl = username.startsWith('http') ? username : `https://${username}`;
        const url = new URL(cleanUrl);
        username = url.pathname.split('/').filter(Boolean)[0] || username;
      } catch {
        const match = username.match(/(?:twitter|x)\.com\/([a-zA-Z0-9_]+)/i);
        if (match) username = match[1];
      }
    }
    return username.replace(/^@+/, '').toLowerCase();
  }

  if (addCrawlBtn && crawlUsernameInput) {
    addCrawlBtn.addEventListener('click', async () => {
      const username = normalizeCrawlUsernameInput(crawlUsernameInput.value);
      if (!username) {
        showCrawlMessage('請輸入帳號名稱', 'error');
        return;
      }

      const existingAccount = Array.from(document.querySelectorAll('.crawl-account-item')).some((item) => (
        item.getAttribute('data-username')?.toLowerCase() === username
      ));
      if (existingAccount) {
        showCrawlMessage(`@${username} 已在爬蟲帳號列表中`, 'error');
        return;
      }

      addCrawlBtn.disabled = true;
      addCrawlBtn.textContent = '新增中...';

      try {
        const res = await fetch('/api/crawl-accounts', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ username })
        });
        const data = await res.json();

        if (res.ok && data.success) {
          const cleanUsername = data.username || username;
          showCrawlMessage(`已新增 @${cleanUsername}`, 'success');
          crawlUsernameInput.value = '';
          
          // Add to DOM — insert at top (newest first, matching ORDER BY created_at DESC)
          if (crawlEmptyText) crawlEmptyText.remove();
          const item = document.createElement('div');
          item.className = 'crawl-account-item';
          item.setAttribute('data-username', cleanUsername);
          item.innerHTML = `
            <div class="crawl-account-info">
              <span class="crawl-account-name">@${cleanUsername}</span>
              <a href="https://x.com/${cleanUsername}" target="_blank" rel="noopener noreferrer" class="crawl-account-link" title="前往 Twitter">↗</a>
            </div>
            <div class="crawl-account-settings" style="display: flex; gap: 1rem; align-items: center; flex-wrap: wrap;">
              <label style="display: flex; align-items: center; gap: 0.25rem; font-size: 0.8rem; cursor: pointer; color: var(--text-secondary);">
                <input type="checkbox" class="toggle-enabled-cb" data-username="${cleanUsername}" checked />
                <span>啟用自動爬取</span>
              </label>
              <label style="display: flex; align-items: center; gap: 0.25rem; font-size: 0.8rem; cursor: pointer; color: var(--text-secondary);">
                <input type="checkbox" class="toggle-crawlall-cb" data-username="${cleanUsername}" />
                <span>爬取全部歷史圖片</span>
              </label>
              <button class="btn rename-crawl-btn" data-username="${cleanUsername}" style="font-size: 0.8rem; padding: 0.25rem 0.5rem; margin-left: 0.5rem;">改名</button>
              <button class="btn btn-danger remove-crawl-btn" data-username="${cleanUsername}" style="font-size: 0.8rem; padding: 0.25rem 0.5rem; margin-left: 0.5rem;">移除</button>
            </div>
          `;
          crawlAccountsList?.prepend(item);
          
          // Attach remove handler
          item.querySelector('.remove-crawl-btn')?.addEventListener('click', handleRemoveCrawl);
          item.querySelector('.rename-crawl-btn')?.addEventListener('click', handleRenameCrawl);
          // Attach settings change handlers
          item.querySelectorAll('input[type="checkbox"]').forEach(cb => {
            cb.addEventListener('change', handleToggleCrawlSetting);
          });
        } else {
          showCrawlMessage(data.error || '新增失敗', 'error');
        }
      } catch (err) {
        showCrawlMessage('網路錯誤，請稍後再試', 'error');
      } finally {
        addCrawlBtn.disabled = false;
        addCrawlBtn.textContent = '新增帳號';
      }
    });
  }

  async function handleToggleCrawlSetting(this: HTMLInputElement) {
    const username = this.getAttribute('data-username');
    if (!username) return;

    const isEnabledToggle = this.classList.contains('toggle-enabled-cb');
    const isCrawlAllToggle = this.classList.contains('toggle-crawlall-cb');

    const payload: any = { username };
    if (isEnabledToggle) {
      payload.enabled = this.checked;
    } else if (isCrawlAllToggle) {
      payload.crawl_all = this.checked;
    }

    this.disabled = true;

    try {
      const res = await fetch('/api/crawl-accounts', {
        method: 'PUT',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify(payload)
      });
      const data = await res.json();

      if (!res.ok || !data.success) {
        this.checked = !this.checked;
        alert(`更新設定失敗：${data.error || '未知錯誤'}`);
      }
    } catch (err) {
      this.checked = !this.checked;
      alert('更新設定失敗，網路或伺服器錯誤。');
    } finally {
      this.disabled = false;
    }
  }

  async function handleRenameCrawl(this: HTMLElement) {
    const username = this.getAttribute('data-username');
    if (!username) return;

    const nextUsername = normalizeCrawlUsernameInput(prompt(`新的 Twitter/X 帳號（目前 @${username}）`, username) || '');
    if (!nextUsername || nextUsername === username) return;

    (this as HTMLButtonElement).disabled = true;

    try {
      const res = await fetch('/api/crawl-accounts', {
        method: 'PUT',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ username, new_username: nextUsername })
      });
      const data = await res.json();

      if (res.ok && data.success) {
        const cleanUsername = data.username || nextUsername;
        const item = document.querySelector(`.crawl-account-item[data-username="${username}"]`);
        item?.setAttribute('data-username', cleanUsername);
        item?.querySelector('.crawl-account-name')?.replaceChildren(`@${cleanUsername}`);
        const link = item?.querySelector('.crawl-account-link') as HTMLAnchorElement | null;
        if (link) link.href = `https://x.com/${cleanUsername}`;
        item?.querySelectorAll('[data-username]').forEach(el => el.setAttribute('data-username', cleanUsername));
        showCrawlMessage(`已改名：@${username} → @${cleanUsername}`, 'success');
      } else {
        showCrawlMessage(data.error || '改名失敗', 'error');
      }
    } catch (err) {
      showCrawlMessage('網絡錯誤，改名失敗', 'error');
    } finally {
      (this as HTMLButtonElement).disabled = false;
    }
  }

  async function handleRemoveCrawl(this: HTMLElement) {
    const username = this.getAttribute('data-username');
    if (!username) return;
    if (!confirm(`確定要移除 @${username} 嗎？`)) return;

    (this as HTMLButtonElement).disabled = true;
    this.textContent = '移除中...';

    try {
      const res = await fetch('/api/crawl-accounts', {
        method: 'DELETE',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ username })
      });
      const data = await res.json();

      if (res.ok && data.success) {
        const item = document.querySelector(`.crawl-account-item[data-username="${username}"]`);
        if (item) item.remove();

        const remaining = document.querySelectorAll('.crawl-account-item');
        if (remaining.length === 0 && crawlAccountsList) {
          const empty = document.createElement('p');
          empty.className = 'empty-text';
          empty.id = 'crawl-empty-text';
          empty.textContent = '尚未新增任何爬取帳號。';
          crawlAccountsList.appendChild(empty);
        }
        showCrawlMessage(`已移除 @${username}`, 'success');
      } else {
        showCrawlMessage(data.error || '移除失敗', 'error');
        (this as HTMLButtonElement).disabled = false;
        this.textContent = '移除';
      }
    } catch (err) {
      showCrawlMessage('網路錯誤', 'error');
      (this as HTMLButtonElement).disabled = false;
      this.textContent = '移除';
    }
  }

  // Attach remove handlers to existing buttons
  document.querySelectorAll('.remove-crawl-btn').forEach(btn => {
    btn.addEventListener('click', handleRemoveCrawl);
  });
  document.querySelectorAll('.rename-crawl-btn').forEach(btn => {
    btn.addEventListener('click', handleRenameCrawl);
  });

  // =========== Admin List — Server-Side Pagination via AJAX ===========
  const searchInput = document.getElementById('search-input') as HTMLInputElement | null;
  const authorFilter = document.getElementById('author-filter') as HTMLSelectElement | null;
  const tagFilter = document.getElementById('tag-filter') as HTMLSelectElement | null;
  const mediaFilter = document.getElementById('media-filter') as HTMLSelectElement | null;
  const sortFilter = document.getElementById('sort-filter') as HTMLSelectElement | null;
  const paginationInfo = document.getElementById('pagination-info');
  const firstPageBtn = document.getElementById('first-page-btn') as HTMLButtonElement | null;
  const prevPageBtn = document.getElementById('prev-page-btn') as HTMLButtonElement | null;
  const nextPageBtn = document.getElementById('next-page-btn') as HTMLButtonElement | null;
  const lastPageBtn = document.getElementById('last-page-btn') as HTMLButtonElement | null;
  const totalCountDisplay = document.getElementById('total-count-display');
  const tableBody = document.getElementById('admin-table-body');
  const gridBody = document.getElementById('admin-grid-view');
  const emptyState = document.getElementById('admin-empty-state');
  const gridEmptyState = document.getElementById('admin-grid-empty-state');
  const tableViewEl = document.querySelector('.view-mode-table') as HTMLElement | null;
  const gridViewEl = document.querySelector('.view-mode-grid') as HTMLElement | null;

  let activeView: 'table' | 'grid' = (localStorage.getItem('admin-active-view') as 'table' | 'grid') || 'table';
  let currentPage = parseInt(sessionStorage.getItem('admin-current-page') || '1', 10);
  if (isNaN(currentPage) || currentPage < 1) currentPage = 1;
  let selectedIds = new Set<number>();
  let totalItems = 0;
  let postsLoading = false;
  let searchDebounce: ReturnType<typeof setTimeout> | null = null;

  let suppressNextClick = false;
  let suppressClickTimer: ReturnType<typeof setTimeout> | null = null;

  function armClickSuppression() {
    suppressNextClick = true;
    if (suppressClickTimer) clearTimeout(suppressClickTimer);
    suppressClickTimer = setTimeout(() => {
      suppressNextClick = false;
    }, 300);
  }

  interface CachedItemRect {
    id: number;
    element: HTMLElement;
    rect: { left: number; top: number; right: number; bottom: number };
  }

  interface DragState {
    pointerId: number;
    startX: number;
    startY: number;
    active: boolean;
    mode: 'add' | 'remove';
    baseSelection: Set<number>;
    candidateIds: Set<number>;
    itemRects: CachedItemRect[];
    targetElement: HTMLElement;
  }

  let dragState: DragState | null = null;
  let dragFrame: number | null = null;
  let latestPointerX = 0;
  let latestPointerY = 0;
  let dragBoxEl: HTMLElement | null = null;

  function ensureDragSelectBox(): HTMLElement {
    if (!dragBoxEl) {
      dragBoxEl = document.createElement('div');
      dragBoxEl.id = 'drag-select-box';
      document.body.appendChild(dragBoxEl);
    }
    dragBoxEl.style.display = 'block';
    return dragBoxEl;
  }

  function removeDragSelectBox() {
    if (dragBoxEl) {
      dragBoxEl.style.display = 'none';
    }
  }

  function resetDragUi() {
    document.body.style.userSelect = '';
    getCurrentPageItems().forEach((el) => el.classList.remove('is-drag-preview'));
    removeDragSelectBox();
  }

  function cancelActiveDrag() {
    if (dragFrame !== null) {
      cancelAnimationFrame(dragFrame);
      dragFrame = null;
    }

    if (dragState) {
      try {
        dragState.targetElement.releasePointerCapture(dragState.pointerId);
      } catch {}

      dragState = null;
    }

    resetDragUi();
  }

  function itemsPerPage() {
    return activeView === 'grid' ? 25 : 10;
  }

  function currentFilters() {
    return {
      published: activeTab === 'pending' ? '0' : '1',
      search: (searchInput?.value || '').trim(),
      author: authorFilter?.value || '',
      tag: tagFilter?.value || '',
      media: mediaFilter?.value || '',
      sort: sortFilter?.value || 'newest',
    };
  }

  async function loadPosts(page: number = 1) {
    cancelActiveDrag();
    if (postsLoading) return;
    postsLoading = true;
    currentPage = page;
    sessionStorage.setItem('admin-current-page', String(page));

    const perPage = itemsPerPage();
    const offset = (page - 1) * perPage;
    const filters = currentFilters();

    const params = new URLSearchParams({
      offset: String(offset),
      limit: String(perPage),
      published: filters.published,
      sort: filters.sort,
    });
    if (filters.search) params.set('search', filters.search);
    if (filters.author) params.set('author', filters.author);
    if (filters.tag) params.set('tag', filters.tag);
    if (filters.media) params.set('media', filters.media);

    if (paginationInfo) paginationInfo.textContent = '載入中...';

    try {
      const res = await fetch(`/api/admin-posts?${params}`);
      if (!res.ok) throw new Error(`HTTP ${res.status}`);
      const data = await res.json();

      totalItems = data.total;

      const totalPages = Math.ceil(totalItems / perPage) || 1;
      if (currentPage > totalPages) {
        postsLoading = false;
        loadPosts(totalPages);
        return;
      }

      if (tableBody) tableBody.innerHTML = data.table_rows || '';
      if (gridBody) gridBody.innerHTML = data.grid_cards || '';

      const isEmpty = data.total === 0;
      if (emptyState) emptyState.style.display = isEmpty ? 'block' : 'none';
      if (gridEmptyState) gridEmptyState.style.display = isEmpty ? 'block' : 'none';

      hydratePostMedia();
      rebindRowHandlers();
      renderSelectionState();

      if (paginationInfo) {
        if (totalItems > 0) {
          paginationInfo.textContent = `顯示第 ${data.showing_start}-${data.showing_end} 筆，共 ${totalItems} 筆`;
        } else {
          paginationInfo.textContent = '查無任何貼文';
        }
      }
      if (totalCountDisplay) totalCountDisplay.textContent = totalItems.toString();
      if (firstPageBtn) firstPageBtn.disabled = currentPage === 1;
      if (prevPageBtn) prevPageBtn.disabled = currentPage === 1;
      if (nextPageBtn) nextPageBtn.disabled = currentPage >= totalPages;
      if (lastPageBtn) lastPageBtn.disabled = currentPage >= totalPages;
    } catch (err) {
      console.error('Failed to load admin posts:', err);
      if (paginationInfo) paginationInfo.textContent = '載入失敗';
    } finally {
      postsLoading = false;
    }
  }

  function rebindRowHandlers() {
    document.querySelectorAll('.edit-btn').forEach((btn) => {
      btn.addEventListener('click', () => {
        const id = btn.getAttribute('data-id');
        const title = btn.getAttribute('data-title') || '';
        const description = btn.getAttribute('data-description') || '';
        const author = btn.getAttribute('data-author') || '';
        const authorDisplayName = btn.getAttribute('data-author-display-name') || '';
        const authorUrl = btn.getAttribute('data-author-url') || '';
        const postUrl = btn.getAttribute('data-post-url') || '';
        const tags = btn.getAttribute('data-tags') || '';
        const keys = btn.getAttribute('data-keys') || '';
        if (id) {
          enterEditMode(id, { title, description, author, authorDisplayName, authorUrl, postUrl, tags, keys });
          window.location.hash = 'upload';
          requestAnimationFrame(() => uploadForm?.scrollIntoView({ behavior: 'smooth' }));
        }
      });
    });

    document.querySelectorAll('.delete-btn').forEach((btn) => {
      btn.addEventListener('click', async () => {
        const imgId = btn.getAttribute('data-id');
        if (!imgId) return;
        if (!confirm('你確定要刪除這張照片貼文嗎？此操作將會從資料庫與 Cloudflare R2 中永久刪除該貼文的所有照片！')) return;
        (btn as HTMLButtonElement).disabled = true;
        btn.textContent = '刪除中...';
        try {
          const response = await fetch(`/api/images/${imgId}`, { method: 'DELETE' });
          const data = await response.json();
          if (response.ok && data.success) {
            const idInt = parseInt(imgId, 10);
            if (!isNaN(idInt)) selectedIds.delete(idInt);
            loadPosts(currentPage);
            refreshStorage();
          } else {
            alert(`刪除失敗：${data.error || '未知錯誤'}`);
            (btn as HTMLButtonElement).disabled = false;
            btn.textContent = '刪除';
          }
        } catch (err) {
          console.error(err);
          alert('刪除失敗，伺服器發生錯誤。');
          (btn as HTMLButtonElement).disabled = false;
          btn.textContent = '刪除';
        }
      });
    });

    document.querySelectorAll('.approve-btn').forEach((btn) => {
      btn.addEventListener('click', async () => {
        const imgId = btn.getAttribute('data-id');
        if (!imgId) return;
        (btn as HTMLButtonElement).disabled = true;
        btn.textContent = '核准中...';
        try {
          const response = await fetch('/api/admin/approve', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ id: imgId })
          });
          const data = await response.json();
          if (response.ok && data.success) {
            const idInt = parseInt(imgId, 10);
            if (!isNaN(idInt)) selectedIds.delete(idInt);
            loadPosts(currentPage);
          } else {
            alert(`核准失敗：${data.error || '未知錯誤'}`);
            (btn as HTMLButtonElement).disabled = false;
            btn.textContent = '核准';
          }
        } catch (err) {
          console.error(err);
          alert('核准失敗，伺服器發生錯誤。');
          (btn as HTMLButtonElement).disabled = false;
          btn.textContent = '核准';
        }
      });
    });
  }

  searchInput?.addEventListener('input', () => {
    sessionStorage.setItem('admin-filter-search', searchInput.value);
    if (searchDebounce) clearTimeout(searchDebounce);
    searchDebounce = setTimeout(() => loadPosts(1), 300);
  });
  authorFilter?.addEventListener('change', () => {
    sessionStorage.setItem('admin-filter-author', authorFilter.value);
    loadPosts(1);
  });
  tagFilter?.addEventListener('change', () => {
    sessionStorage.setItem('admin-filter-tag', tagFilter.value);
    loadPosts(1);
  });
  mediaFilter?.addEventListener('change', () => {
    sessionStorage.setItem('admin-filter-media', mediaFilter.value);
    loadPosts(1);
  });
  sortFilter?.addEventListener('change', () => {
    sessionStorage.setItem('admin-filter-sort', sortFilter.value);
    loadPosts(1);
  });

  firstPageBtn?.addEventListener('click', () => { if (currentPage > 1) loadPosts(1); });
  prevPageBtn?.addEventListener('click', () => { if (currentPage > 1) loadPosts(currentPage - 1); });
  nextPageBtn?.addEventListener('click', () => {
    const totalPages = Math.ceil(totalItems / itemsPerPage()) || 1;
    if (currentPage < totalPages) loadPosts(currentPage + 1);
  });
  lastPageBtn?.addEventListener('click', () => {
    const totalPages = Math.ceil(totalItems / itemsPerPage()) || 1;
    if (currentPage < totalPages) loadPosts(totalPages);
  });

  document.addEventListener('keydown', (e) => {
    const active = document.activeElement;
    if (active && (active.tagName === 'INPUT' || active.tagName === 'TEXTAREA' || active.isContentEditable)) {
      return;
    }
    const postsPanel = document.getElementById('panel-posts');
    if (!postsPanel || postsPanel.hidden) return;
    if (e.key === 'ArrowLeft') { if (prevPageBtn && !prevPageBtn.disabled) prevPageBtn.click(); }
    else if (e.key === 'ArrowRight') { if (nextPageBtn && !nextPageBtn.disabled) nextPageBtn.click(); }
  });

  const viewToggleTable = document.getElementById('view-toggle-table');
  const viewToggleGrid = document.getElementById('view-toggle-grid');

  function switchView(view: 'table' | 'grid') {
    if (activeView === view) return;
    cancelActiveDrag();
    activeView = view;
    localStorage.setItem('admin-active-view', view);
    
    if (view === 'table') {
      viewToggleTable?.classList.add('active');
      viewToggleGrid?.classList.remove('active');
      if (tableViewEl) tableViewEl.style.display = 'block';
      if (gridViewEl) gridViewEl.style.display = 'none';
    } else {
      viewToggleGrid?.classList.add('active');
      viewToggleTable?.classList.remove('active');
      if (gridViewEl) gridViewEl.style.display = 'block';
      if (tableViewEl) tableViewEl.style.display = 'none';
    }
    loadPosts(currentPage);
  }

  viewToggleTable?.addEventListener('click', () => switchView('table'));
  viewToggleGrid?.addEventListener('click', () => switchView('grid'));

  selectPageBtn?.addEventListener('click', toggleCurrentPageSelection);
  selectAllCheckbox?.addEventListener('change', toggleCurrentPageSelection);
  clearSelectionBtn?.addEventListener('click', () => {
    selectedIds.clear();
    renderSelectionState();
  });

  document.querySelectorAll('.toggle-enabled-cb, .toggle-crawlall-cb').forEach(cb => {
    cb.addEventListener('change', handleToggleCrawlSetting);
  });

  document.addEventListener('change', (e) => {
    const target = e.target as HTMLElement;
    if (target && target.classList.contains('image-select-checkbox')) {
      const htmlCb = target as HTMLInputElement;
      const idAttr = htmlCb.getAttribute('data-id');
      const id = idAttr ? parseInt(idAttr, 10) : NaN;
      if (!isNaN(id)) {
        if (htmlCb.checked) selectedIds.add(id);
        else selectedIds.delete(id);
      }
      renderSelectionState();
    }
  });

  document.addEventListener('click', (e) => {
    if (suppressNextClick) {
      suppressNextClick = false;
      e.preventDefault();
      e.stopPropagation();
      return;
    }
    const target = e.target as HTMLElement;
    if (target.tagName === 'INPUT' || target.tagName === 'BUTTON' || target.closest('button') || target.closest('a')) return;

    const gridCard = target.closest('.grid-image-card') as HTMLElement | null;
    if (gridCard) {
      const cb = gridCard.querySelector('.image-select-checkbox') as HTMLInputElement | null;
      if (cb) {
        cb.checked = !cb.checked;
        cb.dispatchEvent(new Event('change', { bubbles: true }));
      }
      return;
    }

    const thumbContainer = target.closest('.thumb-container') as HTMLElement | null;
    if (thumbContainer) {
      const row = thumbContainer.closest('.image-row') as HTMLElement | null;
      if (row) {
        const cb = row.querySelector('.image-select-checkbox') as HTMLInputElement | null;
        if (cb) {
          cb.checked = !cb.checked;
          cb.dispatchEvent(new Event('change', { bubbles: true }));
        }
      }
    }
  });

  // Pointer Event Drag-to-Select Engine
  function processDragFrame(x: number, y: number) {
    if (!dragState) return;

    const boxRect = getSelectionRect(
      dragState.startX,
      dragState.startY,
      x,
      y
    );

    if (dragBoxEl) {
      dragBoxEl.style.left = `${boxRect.left}px`;
      dragBoxEl.style.top = `${boxRect.top}px`;
      dragBoxEl.style.width = `${boxRect.width}px`;
      dragBoxEl.style.height = `${boxRect.height}px`;
    }

    const newCandidates = new Set<number>();
    dragState.itemRects.forEach((item) => {
      const isOverlapping = rectOverlap(boxRect, item.rect);
      item.element.classList.toggle('is-drag-preview', isOverlapping);
      if (isOverlapping) {
        newCandidates.add(item.id);
      }
    });

    dragState.candidateIds = newCandidates;
  }

  const panelPostsEl = document.getElementById('panel-posts');
  if (panelPostsEl) {
    panelPostsEl.addEventListener('dragstart', (e) => {
      const target = e.target as HTMLElement | null;
      if (target?.closest('.image-row, .grid-image-card')) {
        e.preventDefault();
      }
    });

    panelPostsEl.addEventListener('pointerdown', (e: PointerEvent) => {
      if (postsLoading) return;
      if (!e.isPrimary) return;
      if (e.pointerType === 'mouse' && e.button !== 0) return;

      const target = e.target as HTMLElement | null;
      if (!target) return;

      const isTouch = e.pointerType === 'touch';

      if (isTouch) {
        if (!target.closest('[data-drag-select-handle]')) return;
      } else {
        if (!target.closest('.image-row, .grid-image-card')) return;
        if (target.closest('button, a, input, select, textarea, [contenteditable]')) return;
      }

      const startItemEl = target.closest<HTMLElement>('.image-row, .grid-image-card');
      if (!startItemEl) return;

      const startId = parseInt(startItemEl.getAttribute('data-id') || '', 10);
      if (isNaN(startId)) return;

      const mode: 'add' | 'remove' = selectedIds.has(startId) ? 'remove' : 'add';

      const visibleItems = getCurrentPageItems();
      const itemRects: CachedItemRect[] = visibleItems
        .map((el) => {
          const b = el.getBoundingClientRect();
          return {
            id: parseInt(el.getAttribute('data-id') || '', 10),
            element: el,
            rect: { left: b.left, top: b.top, right: b.right, bottom: b.bottom },
          };
        })
        .filter((item) => !isNaN(item.id));

      dragState = {
        pointerId: e.pointerId,
        startX: e.clientX,
        startY: e.clientY,
        active: false,
        mode,
        baseSelection: new Set<number>(selectedIds),
        candidateIds: new Set<number>(),
        itemRects,
        targetElement: target,
      };

      try {
        target.setPointerCapture(e.pointerId);
      } catch {}
    });

    panelPostsEl.addEventListener('pointermove', (e: PointerEvent) => {
      if (!dragState || dragState.pointerId !== e.pointerId) return;

      latestPointerX = e.clientX;
      latestPointerY = e.clientY;

      const dist = Math.hypot(e.clientX - dragState.startX, e.clientY - dragState.startY);
      if (!dragState.active && dist >= 6) {
        dragState.active = true;
        ensureDragSelectBox();
        document.body.style.userSelect = 'none';
      }

      if (!dragState.active) return;

      if (dragFrame === null) {
        dragFrame = requestAnimationFrame(() => {
          dragFrame = null;
          processDragFrame(latestPointerX, latestPointerY);
        });
      }
    });

    const handlePointerUpOrCancel = (e: PointerEvent) => {
      if (!dragState || dragState.pointerId !== e.pointerId) return;

      latestPointerX = e.clientX;
      latestPointerY = e.clientY;

      if (dragFrame !== null) {
        cancelAnimationFrame(dragFrame);
        dragFrame = null;
      }

      const dist = Math.hypot(e.clientX - dragState.startX, e.clientY - dragState.startY);
      if (!dragState.active && dist >= 6) {
        dragState.active = true;
      }

      if (dragState.active && e.type === 'pointerup') {
        processDragFrame(latestPointerX, latestPointerY);
      }

      const wasActive = dragState.active;
      const { baseSelection, candidateIds, mode } = dragState;

      try {
        dragState.targetElement.releasePointerCapture(e.pointerId);
      } catch {}

      dragState = null;
      resetDragUi();

      if (wasActive && e.type === 'pointerup') {
        armClickSuppression();
        selectedIds = applySelectionMode(baseSelection, candidateIds, mode);
        renderSelectionState();
      }
    };

    panelPostsEl.addEventListener('pointerup', handlePointerUpOrCancel);
    panelPostsEl.addEventListener('pointercancel', handlePointerUpOrCancel);
  }

  autoTagBtn?.addEventListener('click', async () => {
    const confirmed = confirm('確定要重新掃描所有圖片嗎？\n只會新增缺少的 Auto-tags，不會移除人工標籤。');
    if (!confirmed) return;

    autoTagBtn.disabled = true;
    let cursor = 0;
    let scanned = 0;
    let added = 0;
    let total = 0;

    updateOperationProgress(
      autoTagProgress,
      autoTagProgressBar,
      autoTagProgressText,
      0,
      1,
      '準備掃描...'
    );

    try {
      while (true) {
        const response = await fetch('/admin/api/auto-tag', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ cursor, limit: 50 })
        });
        const data = await response.json();
        if (!response.ok) throw new Error(data.error || 'Auto-tag 執行失敗');

        scanned += Number(data.scanned || 0);
        added += Number(data.added || 0);
        total = Number(data.total || total);
        updateOperationProgress(
          autoTagProgress,
          autoTagProgressBar,
          autoTagProgressText,
          scanned,
          total,
          `已掃描 ${scanned} / ${total}，已新增 ${added} 個標籤關聯`
        );

        if (data.done) break;
        const nextCursor = Number(data.nextCursor);
        if (!Number.isFinite(nextCursor) || nextCursor <= cursor) {
          throw new Error('Auto-tag cursor 沒有前進');
        }
        cursor = nextCursor;
      }

      if (autoTagProgressText) {
        autoTagProgressText.textContent = `完成：已掃描 ${scanned} 張，新增 ${added} 個標籤關聯`;
      }
      alert(`Auto-tag 完成！\n已掃描 ${scanned} 張圖片，新增 ${added} 個標籤關聯。`);
      window.location.reload();
    } catch (err: any) {
      console.error('Error running auto-tag backfill:', err);
      if (autoTagProgressText) {
        autoTagProgressText.textContent = `失敗：${err.message}`;
      }
      alert(`Auto-tag 執行失敗：${err.message}`);
      autoTagBtn.disabled = false;
    }
  });

  // Bulk delete action handler
  bulkDeleteBtn?.addEventListener('click', async () => {
    const ids = Array.from(selectedIds);

    if (ids.length === 0) return;

    const confirmed = confirm(`確定要刪除這 ${ids.length} 張照片嗎？\n這會自資料庫中移除，並同步刪除 R2 儲存的實體檔案，此操作無法復原！`);
    if (!confirmed) return;

    bulkDeleteBtn.disabled = true;
    if (bulkApproveBtn) bulkApproveBtn.disabled = true;
    bulkDeleteBtn.textContent = '刪除中...';
    let deletedCount = 0;
    updateOperationProgress(
      bulkDeleteProgress,
      bulkDeleteProgressBar,
      bulkDeleteProgressText,
      0,
      ids.length,
      `已刪除 0 / ${ids.length}`
    );

    try {
      deletedCount = await runSequentialBatches(ids, 50, async (batch) => {
        const response = await fetch('/api/images/bulk-delete', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ ids: batch })
        });
        const data = await response.json();
        if (!response.ok || !data.success) {
          throw new Error(data.error || '刪除失敗');
        }
        return Number(data.count || batch.length);
      }, (completed) => {
        deletedCount = completed;
        updateOperationProgress(
          bulkDeleteProgress,
          bulkDeleteProgressBar,
          bulkDeleteProgressText,
          deletedCount,
          ids.length,
          `已刪除 ${deletedCount} / ${ids.length}`
        );
      });

      alert(`成功刪除 ${deletedCount} 筆照片！`);
      selectedIds.clear();
      window.location.reload();
    } catch (err: any) {
      console.error('Error in bulk delete:', err);
      if (bulkDeleteProgressText) {
        bulkDeleteProgressText.textContent = `失敗：已刪除 ${deletedCount} / ${ids.length}。${err.message}`;
      }
      alert(`批次刪除中斷。\n已刪除 ${deletedCount} / ${ids.length} 筆。\n${err.message}`);
      window.location.reload();
    }
  });

  // Bulk approve action handler
  bulkApproveBtn?.addEventListener('click', async () => {
    const ids = Array.from(selectedIds);

    if (ids.length === 0) return;

    const confirmed = confirm(`確定要核准這 ${ids.length} 筆照片嗎？\n核准後將會公開發佈到畫廊！`);
    if (!confirmed) return;

    bulkApproveBtn.disabled = true;
    if (bulkDeleteBtn) bulkDeleteBtn.disabled = true;
    bulkApproveBtn.textContent = '核准中...';
    let approvedCount = 0;
    updateOperationProgress(
      bulkApproveProgress,
      bulkApproveProgressBar,
      bulkApproveProgressText,
      0,
      ids.length,
      `已核准 0 / ${ids.length}`
    );

    try {
      approvedCount = await runSequentialBatches(ids, 50, async (batch) => {
        const response = await fetch('/api/admin/bulk-approve', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ ids: batch })
        });
        const data = await response.json();
        if (!response.ok || !data.success) {
          throw new Error(data.error || '核准失敗');
        }
        return Number(data.count ?? batch.length);
      }, (completed) => {
        approvedCount = completed;
        updateOperationProgress(
          bulkApproveProgress,
          bulkApproveProgressBar,
          bulkApproveProgressText,
          approvedCount,
          ids.length,
          `已核准 ${approvedCount} / ${ids.length}`
        );
      });

      alert(`成功核准 ${approvedCount} 筆照片！`);
      selectedIds.clear();
      window.location.reload();
    } catch (err: any) {
      console.error('Error in bulk approve:', err);
      if (bulkApproveProgressText) {
        bulkApproveProgressText.textContent = `失敗：已核准 ${approvedCount} / ${ids.length}。${err.message}`;
      }
      alert(`批次核准中斷。\n已核准 ${approvedCount} / ${ids.length} 筆。\n${err.message}`);
      window.location.reload();
    }
  });

  // =========== Tab switching listeners ===========
  function switchTab(newTab: 'published' | 'pending', page: number = 1) {
    if (activeTab === newTab) return;
    activeTab = newTab;
    sessionStorage.setItem('admin-post-tab', activeTab);
    selectedIds.clear(); // 切換 Tab 時清空選取

    if (bulkApproveBtn) {
      bulkApproveBtn.style.display = activeTab === 'pending' ? 'inline-block' : 'none';
    }

    if (tabPublished && tabPending) {
      if (activeTab === 'published') {
        tabPublished.classList.add('active');
        (tabPublished as HTMLElement).style.color = 'var(--text-primary)';
        (tabPublished as HTMLElement).style.borderBottom = '2px solid var(--text-primary)';
        (tabPublished as HTMLElement).style.fontWeight = '600';

        tabPending.classList.remove('active');
        (tabPending as HTMLElement).style.color = 'var(--text-secondary)';
        (tabPending as HTMLElement).style.borderBottom = '2px solid transparent';
        (tabPending as HTMLElement).style.fontWeight = '500';
      } else {
        tabPending.classList.add('active');
        (tabPending as HTMLElement).style.color = 'var(--text-primary)';
        (tabPending as HTMLElement).style.borderBottom = '2px solid var(--text-primary)';
        (tabPending as HTMLElement).style.fontWeight = '600';

        tabPublished.classList.remove('active');
        (tabPublished as HTMLElement).style.color = 'var(--text-secondary)';
        (tabPublished as HTMLElement).style.borderBottom = '2px solid transparent';
        (tabPublished as HTMLElement).style.fontWeight = '500';
      }
    }

    loadPosts(page);
  }

  tabPublished?.addEventListener('click', () => switchTab('published', 1));
  tabPending?.addEventListener('click', () => switchTab('pending', 1));

  // 同步初始化篩選器 DOM 狀態
  if (searchInput) searchInput.value = sessionStorage.getItem('admin-filter-search') || '';
  if (authorFilter) authorFilter.value = sessionStorage.getItem('admin-filter-author') || '';
  if (tagFilter) tagFilter.value = sessionStorage.getItem('admin-filter-tag') || '';
  if (mediaFilter) mediaFilter.value = sessionStorage.getItem('admin-filter-media') || '';
  if (sortFilter) sortFilter.value = sessionStorage.getItem('admin-filter-sort') || 'newest';

  // 同步初始化 View 模式的 DOM 狀態
  if (activeView === 'grid') {
    viewToggleGrid?.classList.add('active');
    viewToggleTable?.classList.remove('active');
    if (gridViewEl) gridViewEl.style.display = 'block';
    if (tableViewEl) tableViewEl.style.display = 'none';
  } else {
    viewToggleTable?.classList.add('active');
    viewToggleGrid?.classList.remove('active');
    if (tableViewEl) tableViewEl.style.display = 'block';
    if (gridViewEl) gridViewEl.style.display = 'none';
  }

  // 初始化 Tab 狀態（若有記憶中的待審查狀態則還原）
  const savedPostTab = sessionStorage.getItem('admin-post-tab');
  if (savedPostTab === 'pending') {
    switchTab('pending', currentPage);
  } else {
    if (bulkApproveBtn) bulkApproveBtn.style.display = 'none';
    loadPosts(currentPage);
  }
</script>
